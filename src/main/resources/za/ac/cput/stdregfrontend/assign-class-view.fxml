<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="za.ac.cput.stdregfrontend.AssignClassController"
      spacing="15"
      prefWidth="500"
      prefHeight="320"
      style="-fx-background-color: #f4f4f4;">

    <padding>
        <Insets top="25"
                right="30"
                bottom="25"
                left="30"/>
    </padding>


    <!-- ============================================================
         TITLE
         ============================================================ -->

    <Label text="ASSIGN CLASS TO LECTURER"
           style="-fx-font-size: 22px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #1f2937;"/>


    <!-- ============================================================
         LECTURER
         ============================================================ -->

    <Label text="Lecturer:"
           style="-fx-font-weight: bold;
                  -fx-font-size: 13px;"/>

    <Label fx:id="lecturerNameLabel"
           style="-fx-font-size: 17px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #1f2937;"/>


    <!-- ============================================================
         PERSON ID
         ============================================================ -->

    <Label text="Person ID:"
           style="-fx-font-weight: bold;
                  -fx-font-size: 13px;"/>

    <Label fx:id="lecturerIdLabel"
           style="-fx-font-size: 15px;
                  -fx-text-fill: #374151;"/>


    <!-- ============================================================
         CLASS SELECTION
         ============================================================ -->

    <Label text="Select Class:"
           style="-fx-font-weight: bold;
                  -fx-font-size: 13px;"/>

    <ComboBox fx:id="classComboBox"
              prefWidth="440"
              prefHeight="38"
              promptText="Select a class"/>


    <!-- ============================================================
         ACTION BUTTONS
         ============================================================ -->

    <VBox spacing="10">

        <Button text="Assign Class"
                prefWidth="440"
                prefHeight="40"
                style="-fx-font-size: 14px;
                       -fx-font-weight: bold;"
                onAction="#onAssignClick"/>

        <Button text="Cancel"
                prefWidth="440"
                prefHeight="40"
                style="-fx-font-size: 14px;"
                onAction="#onCancelClick"/>

    </VBox>

</VBox>