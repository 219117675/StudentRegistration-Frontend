<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="za.ac.cput.stdregfrontend.EditCourseController"
      spacing="20"
      prefWidth="600"
      prefHeight="450">

    <padding>
        <Insets top="30"
                right="30"
                bottom="30"
                left="30"/>
    </padding>


    <!-- ========================================================= -->
    <!-- TITLE -->
    <!-- ========================================================= -->

    <Label text="Edit Course"
           style="-fx-font-size: 26px;
                  -fx-font-weight: bold;"/>


    <!-- ========================================================= -->
    <!-- FORM -->
    <!-- ========================================================= -->

    <GridPane hgap="15"
              vgap="18">

        <Label text="Course ID:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="courseIdField"
                   editable="false"
                   prefWidth="350"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>


        <Label text="Course Code:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="courseCodeField"
                   editable="false"
                   prefWidth="350"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>


        <Label text="Course Name:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="courseNameField"
                   promptText="Course name"
                   prefWidth="350"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>


        <Label text="Department:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <ComboBox fx:id="departmentComboBox"
                  promptText="Select Department"
                  prefWidth="350"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="3"/>

    </GridPane>


    <!-- ========================================================= -->
    <!-- BUTTONS -->
    <!-- ========================================================= -->

    <HBox spacing="15"
          alignment="CENTER_RIGHT">

        <Button fx:id="saveButton"
                text="Save Changes"
                onAction="#onSaveClick"
                prefWidth="130"/>

        <Button fx:id="cancelButton"
                text="Cancel"
                onAction="#onCancelClick"
                prefWidth="100"/>

    </HBox>

</VBox>