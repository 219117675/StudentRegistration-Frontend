<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="za.ac.cput.stdregfrontend.EditLecturerController"
      spacing="18"
      prefWidth="500"
      prefHeight="500"
      style="-fx-background-color: #f4f4f4;">

    <padding>
        <Insets top="30"
                right="35"
                bottom="30"
                left="35"/>
    </padding>

    <!-- TITLE -->

    <VBox spacing="5">

        <Label text="EDIT LECTURER"
               style="-fx-font-size: 24px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #1f2937;"/>

        <Label text="Update lecturer information"
               style="-fx-font-size: 14px;
                      -fx-text-fill: #6b7280;"/>

    </VBox>


    <!-- FORM -->

    <GridPane hgap="15"
              vgap="15">

        <Label text="Person ID:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <Label fx:id="personIdLabel"
               text="-"
               GridPane.columnIndex="1"
               GridPane.rowIndex="0"
               style="-fx-font-weight: bold;"/>


        <Label text="Lecturer ID:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <Label fx:id="lecturerIdLabel"
               text="-"
               GridPane.columnIndex="1"
               GridPane.rowIndex="1"
               style="-fx-font-weight: bold;"/>


        <Label text="First Name:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="firstNameField"
                   prefWidth="280"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>


        <Label text="Last Name:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <TextField fx:id="lastNameField"
                   prefWidth="280"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>


        <Label text="Employee Number:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"/>

        <TextField fx:id="employeeNumberField"
                   prefWidth="280"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="4"/>


        <Label text="Email:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="5"/>

        <TextField fx:id="emailField"
                   prefWidth="280"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="5"/>


        <Label text="Department:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="6"/>

        <ComboBox fx:id="departmentComboBox"
                  prefWidth="280"
                  promptText="Select Department"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="6"/>

    </GridPane>


    <!-- BUTTONS -->

    <HBox spacing="10"
          alignment="CENTER_RIGHT">

        <Button text="Cancel"
                prefWidth="100"
                prefHeight="35"
                onAction="#onCancelClick"/>

        <Button text="Save Changes"
                prefWidth="120"
                prefHeight="35"
                style="-fx-background-color: #2563eb;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"
                onAction="#onSaveClick"/>

    </HBox>

</VBox>