<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="za.ac.cput.stdregfrontend.RegistrationDetailsController"
      spacing="20"
      prefWidth="650"
      prefHeight="500">

    <padding>
        <Insets top="30"
                right="30"
                bottom="30"
                left="30"/>
    </padding>


    <Label text="Registration Details"
           style="-fx-font-size: 26px;
                  -fx-font-weight: bold;"/>


    <GridPane hgap="20"
              vgap="14">

        <!-- REGISTRATION -->

        <Label text="Registration ID:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <Label fx:id="registrationIdLabel"
               text="Not provided"
               GridPane.rowIndex="0"
               GridPane.columnIndex="1"/>


        <!-- STUDENT -->

        <Label text="Student Number:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <Label fx:id="studentNumberLabel"
               text="Not provided"
               GridPane.rowIndex="1"
               GridPane.columnIndex="1"/>


        <Label text="Student Name:"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <Label fx:id="studentNameLabel"
               text="Not provided"
               GridPane.rowIndex="2"
               GridPane.columnIndex="1"/>


        <Label text="Student Email:"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <Label fx:id="studentEmailLabel"
               text="Not provided"
               GridPane.rowIndex="3"
               GridPane.columnIndex="1"/>


        <!-- CLASS -->

        <Label text="Class Code:"
               GridPane.rowIndex="4"
               GridPane.columnIndex="0"/>

        <Label fx:id="classCodeLabel"
               text="Not provided"
               GridPane.rowIndex="4"
               GridPane.columnIndex="1"/>


        <Label text="Class Name:"
               GridPane.rowIndex="5"
               GridPane.columnIndex="0"/>

        <Label fx:id="classNameLabel"
               text="Not provided"
               GridPane.rowIndex="5"
               GridPane.columnIndex="1"/>


        <!-- COURSE -->

        <Label text="Course Code:"
               GridPane.rowIndex="6"
               GridPane.columnIndex="0"/>

        <Label fx:id="courseCodeLabel"
               text="Not provided"
               GridPane.rowIndex="6"
               GridPane.columnIndex="1"/>


        <Label text="Course Name:"
               GridPane.rowIndex="7"
               GridPane.columnIndex="0"/>

        <Label fx:id="courseNameLabel"
               text="Not provided"
               GridPane.rowIndex="7"
               GridPane.columnIndex="1"/>


        <!-- DEPARTMENT -->

        <Label text="Department:"
               GridPane.rowIndex="8"
               GridPane.columnIndex="0"/>

        <Label fx:id="departmentLabel"
               text="Not provided"
               GridPane.rowIndex="8"
               GridPane.columnIndex="1"/>


        <!-- LECTURER -->

        <Label text="Lecturer:"
               GridPane.rowIndex="9"
               GridPane.columnIndex="0"/>

        <Label fx:id="lecturerLabel"
               text="Not assigned"
               GridPane.rowIndex="9"
               GridPane.columnIndex="1"/>

    </GridPane>


    <Button text="Close"
            onAction="#onCloseClick"
            prefWidth="100"/>

</VBox>