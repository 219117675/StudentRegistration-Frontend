<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="za.ac.cput.stdregfrontend.AddLecturerController"
      spacing="15"
      prefWidth="700"
      prefHeight="850"
      style="-fx-background-color: #f4f4f4;">

    <padding>
        <Insets top="25"
                right="30"
                bottom="25"
                left="30"/>
    </padding>

    <!-- =========================================================
         TITLE
         ========================================================= -->

    <Label text="ADD NEW LECTURER"
           style="-fx-font-size: 24px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #1f2937;"/>

    <Label text="Enter the lecturer's complete information below."
           style="-fx-font-size: 14px;
                  -fx-text-fill: #6b7280;"/>


    <!-- =========================================================
         SCROLLABLE FORM
         ========================================================= -->

    <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS">

        <content>

            <VBox spacing="20">

                <padding>
                    <Insets top="5"
                            right="10"
                            bottom="10"
                            left="5"/>
                </padding>


                <!-- =================================================
                     PERSONAL INFORMATION
                     ================================================= -->

                <Label text="Personal Information"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f2937;"/>

                <GridPane hgap="15"
                          vgap="12">

                    <Label text="First Name:"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="firstNameField"
                               promptText="Enter first name"
                               prefWidth="350"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>


                    <Label text="Last Name:"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="lastNameField"
                               promptText="Enter last name"
                               prefWidth="350"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>


                    <Label text="Date of Birth:"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"/>

                    <DatePicker fx:id="dateOfBirthPicker"
                                prefWidth="350"
                                promptText="Select date of birth"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="1"/>


                    <Label text="Gender:"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="0"/>

                    <ComboBox fx:id="genderComboBox"
                              prefWidth="350"
                              promptText="Select gender"
                              GridPane.rowIndex="3"
                              GridPane.columnIndex="1"/>


                    <Label text="Race:"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="0"/>

                    <ComboBox fx:id="raceComboBox"
                              prefWidth="350"
                              promptText="Select race"
                              GridPane.rowIndex="4"
                              GridPane.columnIndex="1"/>

                </GridPane>


                <!-- =================================================
                     EMPLOYMENT INFORMATION
                     ================================================= -->

                <Label text="Employment Information"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f2937;"/>

                <GridPane hgap="15"
                          vgap="12">

                    <Label text="Lecturer Email:"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="lecturerEmailField"
                               promptText="Enter lecturer email"
                               prefWidth="350"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>


                    <Label text="Department:"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                    <ComboBox fx:id="departmentComboBox"
                              promptText="Select department"
                              prefWidth="350"
                              GridPane.rowIndex="1"
                              GridPane.columnIndex="1"/>

                </GridPane>


                <!-- =================================================
                     EMPLOYEE NUMBER
                     ================================================= -->

                <VBox spacing="5"
                      style="-fx-background-color: #e8f1ff;
                             -fx-background-radius: 8;
                             -fx-padding: 12;">

                    <Label text="Employee Number"
                           style="-fx-font-size: 15px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1f2937;"/>

                    <Label text="Employee number will be generated automatically by the system based on the selected department."
                           wrapText="true"
                           style="-fx-font-size: 13px;
                                  -fx-text-fill: #4b5563;"/>

                    <Label text="Example: ICT001, ICT002, BUS001, BUS002"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #2563eb;"/>

                </VBox>


                <!-- =================================================
                     LOGIN INFORMATION
                     ================================================= -->

                <Label text="Login Information"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f2937;"/>

                <VBox spacing="10"
                      style="-fx-background-color: #fff7ed;
                             -fx-background-radius: 8;
                             -fx-padding: 15;">

                    <Label text="Create Lecturer Login Password"
                           style="-fx-font-size: 15px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1f2937;"/>

                    <Label text="The lecturer will use their lecturer email and this password to log into the system."
                           wrapText="true"
                           style="-fx-font-size: 13px;
                                  -fx-text-fill: #4b5563;"/>

                    <GridPane hgap="15"
                              vgap="12">

                        <Label text="Password:"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"/>

                        <PasswordField fx:id="passwordField"
                                       promptText="Enter login password"
                                       prefWidth="350"
                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="1"/>


                        <Label text="Confirm Password:"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"/>

                        <PasswordField fx:id="confirmPasswordField"
                                       promptText="Confirm login password"
                                       prefWidth="350"
                                       GridPane.rowIndex="1"
                                       GridPane.columnIndex="1"/>

                    </GridPane>

                </VBox>


                <!-- =================================================
                     CONTACT INFORMATION
                     ================================================= -->

                <Label text="Contact Information"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f2937;"/>

                <GridPane hgap="15"
                          vgap="12">

                    <Label text="Contact Email:"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="contactEmailField"
                               promptText="Enter contact email"
                               prefWidth="350"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>


                    <Label text="Phone Number:"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="phoneNumberField"
                               promptText="Enter phone number"
                               prefWidth="350"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                </GridPane>


                <!-- =================================================
                     ADDRESS
                     ================================================= -->

                <Label text="Address"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f2937;"/>

                <GridPane hgap="15"
                          vgap="12">

                    <Label text="Street:"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="streetField"
                               promptText="Enter street"
                               prefWidth="350"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>


                    <Label text="Suburb:"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="suburbField"
                               promptText="Enter suburb"
                               prefWidth="350"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>


                    <Label text="City:"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="cityField"
                               promptText="Enter city"
                               prefWidth="350"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>


                    <Label text="Province:"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="provinceField"
                               promptText="Enter province"
                               prefWidth="350"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="1"/>


                    <Label text="Postal Code:"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="postalCodeField"
                               promptText="Enter postal code"
                               prefWidth="350"
                               GridPane.rowIndex="4"
                               GridPane.columnIndex="1"/>

                </GridPane>

            </VBox>

        </content>

    </ScrollPane>


    <!-- =========================================================
         BUTTONS
         ========================================================= -->

    <HBox spacing="10"
          alignment="CENTER_RIGHT">

        <Button text="Cancel"
                prefWidth="100"
                prefHeight="38"
                onAction="#onCancelClick"/>

        <Button text="Save Lecturer"
                prefWidth="140"
                prefHeight="38"
                style="-fx-background-color: #2563eb;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"
                onAction="#onSaveClick"/>

    </HBox>

</VBox>