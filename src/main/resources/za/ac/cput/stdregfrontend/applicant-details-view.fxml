<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="za.ac.cput.stdregfrontend.ApplicantDetailsController"
        spacing="15">

    <padding>
        <Insets
                top="25"
                right="30"
                bottom="25"
                left="30"/>
    </padding>

    <Label
            text="Applicant Details"
            style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane
            hgap="15"
            vgap="10">

        <Label text="Person ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label fx:id="personIdLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Applicant ID:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label fx:id="applicantIdLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="First Name:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label fx:id="firstNameLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Last Name:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Label fx:id="lastNameLabel" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Date of Birth:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <Label fx:id="dateOfBirthLabel" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Gender:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <Label fx:id="genderLabel" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <Label text="Race:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <Label fx:id="raceLabel" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

        <Label text="Contact Email:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        <Label fx:id="contactEmailLabel" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

        <Label text="Phone Number:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
        <Label fx:id="phoneNumberLabel" GridPane.columnIndex="1" GridPane.rowIndex="8"/>

        <Label text="Street:" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
        <Label fx:id="streetLabel" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

        <Label text="Suburb:" GridPane.columnIndex="0" GridPane.rowIndex="10"/>
        <Label fx:id="suburbLabel" GridPane.columnIndex="1" GridPane.rowIndex="10"/>

        <Label text="City:" GridPane.columnIndex="0" GridPane.rowIndex="11"/>
        <Label fx:id="cityLabel" GridPane.columnIndex="1" GridPane.rowIndex="11"/>

        <Label text="Province:" GridPane.columnIndex="0" GridPane.rowIndex="12"/>
        <Label fx:id="provinceLabel" GridPane.columnIndex="1" GridPane.rowIndex="12"/>

        <Label text="Postal Code:" GridPane.columnIndex="0" GridPane.rowIndex="13"/>
        <Label fx:id="postalCodeLabel" GridPane.columnIndex="1" GridPane.rowIndex="13"/>

    </GridPane>

    <HBox alignment="CENTER_RIGHT">

        <Button
                text="Close"
                onAction="#onCloseClick"/>

    </HBox>

</VBox>