<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="za.ac.cput.stdregfrontend.CourseListController"
            prefWidth="1100"
            prefHeight="700">

    <!-- ========================================================= -->
    <!-- TOP -->
    <!-- ========================================================= -->

    <top>

        <VBox spacing="15">

            <padding>
                <Insets top="25"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>

            <Label text="Course Management"
                   style="-fx-font-size: 26px;
                          -fx-font-weight: bold;"/>

            <HBox spacing="10">

                <TextField fx:id="searchField"
                           promptText="Search by ID, code, course name or department..."
                           prefWidth="430"/>

                <Button text="Search"
                        onAction="#onSearchClick"
                        prefWidth="100"/>

                <Button text="Refresh"
                        onAction="#onRefreshClick"
                        prefWidth="100"/>

            </HBox>

        </VBox>

    </top>


    <!-- ========================================================= -->
    <!-- COURSE TABLE -->
    <!-- ========================================================= -->

    <center>

        <TableView fx:id="courseTable">

            <columns>

                <TableColumn fx:id="courseIdColumn"
                             text="Course ID"
                             prefWidth="150"/>

                <TableColumn fx:id="courseCodeColumn"
                             text="Course Code"
                             prefWidth="180"/>

                <TableColumn fx:id="courseNameColumn"
                             text="Course Name"
                             prefWidth="350"/>

                <TableColumn fx:id="departmentColumn"
                             text="Department"
                             prefWidth="350"/>

            </columns>

        </TableView>

    </center>


    <!-- ========================================================= -->
    <!-- BOTTOM BUTTONS -->
    <!-- ========================================================= -->

    <bottom>

        <HBox spacing="12"
              alignment="CENTER_RIGHT">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="25"
                        left="25"/>
            </padding>

            <Button text="Add Course"
                    onAction="#onAddCourseClick"
                    prefWidth="120"/>

            <Button text="View Details"
                    onAction="#onViewCourseClick"
                    prefWidth="120"/>

            <Button text="Edit Course"
                    onAction="#onEditCourseClick"
                    prefWidth="120"/>

            <Button text="Delete Course"
                    onAction="#onDeleteCourseClick"
                    prefWidth="120"/>

            <Button text="Back"
                    onAction="#onBackClick"
                    prefWidth="100"/>

        </HBox>

    </bottom>

</BorderPane>