<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="za.ac.cput.stdregfrontend.AddRegistrationController"
      spacing="20"
      prefWidth="650"
      prefHeight="450">

    <padding>
        <Insets top="30"
                right="30"
                bottom="30"
                left="30"/>
    </padding>


    <Label text="Register Student"
           style="-fx-font-size: 26px;
                  -fx-font-weight: bold;"/>


    <Label text="Select a student and a class to create a registration."
           style="-fx-text-fill: #666666;"/>


    <GridPane hgap="15"
              vgap="20">

        <Label text="Student:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="studentComboBox"
                  promptText="Select student"
                  prefWidth="420"
                  GridPane.rowIndex="0"
                  GridPane.columnIndex="1"/>


        <Label text="Class:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="classComboBox"
                  promptText="Select class"
                  prefWidth="420"
                  GridPane.rowIndex="1"
                  GridPane.columnIndex="1"/>

    </GridPane>


    <HBox spacing="12"
          alignment="CENTER_RIGHT">

        <Button text="Register Student"
                onAction="#onRegisterClick"
                prefWidth="150"/>

        <Button text="Cancel"
                onAction="#onCancelClick"
                prefWidth="100"/>

    </HBox>

</VBox>