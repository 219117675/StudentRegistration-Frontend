<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="za.ac.cput.stdregfrontend.EditStudentController"
        prefWidth="850"
        prefHeight="750"
        style="-fx-background-color: #f4f6f8;">

    <top>

        <VBox
                spacing="5"
                style="-fx-background-color: #1f3c88;">

            <padding>
                <Insets
                        top="20"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>

            <Label
                    text="Edit Student"
                    style="-fx-text-fill: white;
                           -fx-font-size: 26px;
                           -fx-font-weight: bold;"/>

            <Label
                    text="Update student information"
                    style="-fx-text-fill: #dbe4ff;
                           -fx-font-size: 14px;"/>

        </VBox>

    </top>

    <center>

        <ScrollPane
                fitToWidth="true"
                style="-fx-background-color: transparent;">

            <VBox
                    spacing="20"
                    maxWidth="760">

                <padding>
                    <Insets
                            top="25"
                            right="35"
                            bottom="25"
                            left="35"/>
                </padding>

                <!-- PERSONAL INFORMATION -->

                <VBox
                        spacing="15"
                        style="-fx-background-color: white;
                               -fx-background-radius: 10;
                               -fx-padding: 20;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 8, 0, 0, 2);">

                    <Label
                            text="Personal Information"
                            style="-fx-font-size: 18px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #1f3c88;"/>

                    <GridPane
                            hgap="15"
                            vgap="12">

                        <Label
                                text="First Name:"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="0"/>

                        <TextField
                                fx:id="firstNameField"
                                promptText="First name"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="1"/>

                        <Label
                                text="Last Name:"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="2"/>

                        <TextField
                                fx:id="lastNameField"
                                promptText="Last name"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="3"/>

                        <Label
                                text="Date of Birth:"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="0"/>

                        <DatePicker
                                fx:id="dateOfBirthPicker"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="1"/>

                        <Label
                                text="Gender:"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="2"/>

                        <TextField
                                fx:id="genderField"
                                promptText="Gender"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="3"/>

                        <Label
                                text="Race:"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="0"/>

                        <TextField
                                fx:id="raceField"
                                promptText="Race"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="1"/>

                    </GridPane>

                </VBox>

                <!-- STUDENT INFORMATION -->

                <VBox
                        spacing="15"
                        style="-fx-background-color: white;
                               -fx-background-radius: 10;
                               -fx-padding: 20;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 8, 0, 0, 2);">

                    <Label
                            text="Student Information"
                            style="-fx-font-size: 18px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #1f3c88;"/>

                    <GridPane
                            hgap="15"
                            vgap="12">

                        <Label
                                text="Student Number:"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="0"/>

                        <TextField
                                fx:id="studentNumberField"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="1"
                                editable="false"/>

                        <Label
                                text="Student Email:"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="2"/>

                        <TextField
                                fx:id="studentEmailField"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="3"
                                editable="false"/>

                    </GridPane>

                </VBox>

                <!-- CONTACT INFORMATION -->

                <VBox
                        spacing="15"
                        style="-fx-background-color: white;
                               -fx-background-radius: 10;
                               -fx-padding: 20;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 8, 0, 0, 2);">

                    <Label
                            text="Contact Information"
                            style="-fx-font-size: 18px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #1f3c88;"/>

                    <GridPane
                            hgap="15"
                            vgap="12">

                        <Label
                                text="Phone Number:"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="0"/>

                        <TextField
                                fx:id="phoneNumberField"
                                promptText="Phone number"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="1"/>

                        <Label
                                text="Contact Email:"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="2"/>

                        <TextField
                                fx:id="contactEmailField"
                                promptText="Email"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="3"/>

                    </GridPane>

                </VBox>

                <!-- ADDRESS -->

                <VBox
                        spacing="15"
                        style="-fx-background-color: white;
                               -fx-background-radius: 10;
                               -fx-padding: 20;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 8, 0, 0, 2);">

                    <Label
                            text="Address"
                            style="-fx-font-size: 18px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #1f3c88;"/>

                    <GridPane
                            hgap="15"
                            vgap="12">

                        <Label
                                text="Street:"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="0"/>

                        <TextField
                                fx:id="streetField"
                                promptText="Street"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="1"/>

                        <Label
                                text="Suburb:"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="2"/>

                        <TextField
                                fx:id="suburbField"
                                promptText="Suburb"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="3"/>

                        <Label
                                text="City:"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="0"/>

                        <TextField
                                fx:id="cityField"
                                promptText="City"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="1"/>

                        <Label
                                text="Province:"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="2"/>

                        <TextField
                                fx:id="provinceField"
                                promptText="Province"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="3"/>

                        <Label
                                text="Postal Code:"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="0"/>

                        <TextField
                                fx:id="postalCodeField"
                                promptText="Postal code"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="1"/>

                    </GridPane>

                </VBox>

                <!-- BUTTONS -->

                <HBox
                        spacing="15"
                        alignment="CENTER_RIGHT">

                    <Button
                            fx:id="cancelButton"
                            text="Cancel"
                            onAction="#onCancelClick"
                            prefWidth="110"
                            style="-fx-background-color: #777777;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 10 20;"/>

                    <Button
                            fx:id="saveButton"
                            text="Save Changes"
                            onAction="#onSaveClick"
                            prefWidth="140"
                            style="-fx-background-color: #1f3c88;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 10 20;"/>

                </HBox>

            </VBox>

        </ScrollPane>

    </center>

</BorderPane>