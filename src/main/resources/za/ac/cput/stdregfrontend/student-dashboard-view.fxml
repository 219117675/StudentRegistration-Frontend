<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="za.ac.cput.stdregfrontend.StudentDashboardController"
            prefWidth="1200"
            prefHeight="750"
            style="-fx-background-color: #f4f4f4;">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="20"
              prefHeight="75"
              style="-fx-background-color: #1f2937;">

            <padding>
                <Insets left="30"
                        right="30"/>
            </padding>

            <Label text="STUDENT REGISTRATION SYSTEM"
                   style="-fx-text-fill: white;
                          -fx-font-size: 22px;
                          -fx-font-weight: bold;"/>

            <Label text="STUDENT PORTAL"
                   style="-fx-text-fill: #d1d5db;
                          -fx-font-size: 13px;
                          -fx-font-weight: bold;"/>

        </HBox>

    </top>


    <!-- =========================================================
         SIDEBAR
         ========================================================= -->

    <left>

        <VBox spacing="10"
              prefWidth="220"
              style="-fx-background-color: #111827;">

            <padding>
                <Insets top="25"
                        right="15"
                        bottom="25"
                        left="15"/>
            </padding>

            <Label text="STUDENT MENU"
                   style="-fx-text-fill: #9ca3af;
                          -fx-font-size: 12px;
                          -fx-font-weight: bold;"/>

            <Button text="My Profile"
                    fx:id="profileButton"
                    onAction="#handleProfile"
                    maxWidth="Infinity"
                    prefHeight="42"/>

            <Button text="My Courses"
                    maxWidth="Infinity"
                    prefHeight="42"/>

            <Button text="My Classes"
                    maxWidth="Infinity"
                    prefHeight="42"/>

            <Button text="Registration"
                    maxWidth="Infinity"
                    prefHeight="42"
                    style="-fx-font-weight: bold;"/>

            <Button text="Results"
                    maxWidth="Infinity"
                    prefHeight="42"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Button text="LOGOUT"
                    fx:id="logoutButton"
                    onAction="#handleLogout"
                    maxWidth="Infinity"
                    prefHeight="42"/>

        </VBox>

    </left>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <center>

        <VBox spacing="20"
              alignment="TOP_LEFT">

            <padding>
                <Insets top="30"
                        right="35"
                        bottom="30"
                        left="35"/>
            </padding>


            <!-- =================================================
                 WELCOME
                 ================================================= -->

            <Label fx:id="welcomeLabel"
                   text="Welcome, Student"
                   style="-fx-text-fill: #1f2937;
                          -fx-font-size: 28px;
                          -fx-font-weight: bold;"/>


            <!-- =================================================
                 STUDENT INFORMATION
                 ================================================= -->

            <HBox spacing="25">

                <VBox spacing="5">

                    <Label text="Student Number"
                           style="-fx-font-size: 12px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #6b7280;"/>

                    <Label fx:id="studentNumberLabel"
                           text="-"
                           style="-fx-font-size: 15px;
                                  -fx-text-fill: #1f2937;"/>

                </VBox>


                <VBox spacing="5">

                    <Label text="Email"
                           style="-fx-font-size: 12px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #6b7280;"/>

                    <Label fx:id="emailLabel"
                           text="-"
                           style="-fx-font-size: 15px;
                                  -fx-text-fill: #1f2937;"/>

                </VBox>


                <VBox spacing="5">

                    <Label text="Course"
                           style="-fx-font-size: 12px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #6b7280;"/>

                    <Label fx:id="courseLabel"
                           text="Loading..."
                           style="-fx-font-size: 15px;
                                  -fx-text-fill: #1f2937;"/>

                </VBox>

            </HBox>


            <!-- =================================================
                 SUMMARY CARDS
                 ================================================= -->

            <HBox spacing="20">

                <VBox prefWidth="210"
                      prefHeight="100"
                      alignment="CENTER"
                      spacing="8"
                      style="-fx-background-color: white;
                             -fx-background-radius: 8;
                             -fx-border-color: #e5e7eb;
                             -fx-border-radius: 8;">

                    <Label text="REGISTERED CLASSES"
                           style="-fx-font-size: 12px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #6b7280;"/>

                    <Label fx:id="registeredCountLabel"
                           text="0"
                           style="-fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1f2937;"/>

                </VBox>


                <VBox prefWidth="210"
                      prefHeight="100"
                      alignment="CENTER"
                      spacing="8"
                      style="-fx-background-color: white;
                             -fx-background-radius: 8;
                             -fx-border-color: #e5e7eb;
                             -fx-border-radius: 8;">

                    <Label text="AVAILABLE CLASSES"
                           style="-fx-font-size: 12px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #6b7280;"/>

                    <Label fx:id="availableCountLabel"
                           text="0"
                           style="-fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1f2937;"/>

                </VBox>

            </HBox>


            <!-- =================================================
                 AVAILABLE CLASSES
                 ================================================= -->

            <HBox alignment="CENTER_LEFT">

                <Label text="AVAILABLE CLASSES"
                       style="-fx-font-size: 20px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f2937;"/>

                <VBox HBox.hgrow="ALWAYS"/>

                <Button fx:id="registerButton"
                        text="REGISTER FOR SELECTED CLASS"
                        prefWidth="230"
                        prefHeight="38"
                        onAction="#handleRegister"/>

                <Button fx:id="refreshButton"
                        text="Refresh"
                        prefWidth="90"
                        prefHeight="38"
                        onAction="#handleRefresh"/>

            </HBox>


            <TableView fx:id="availableClassesTable"
                       prefHeight="180">

                <columns>

                    <TableColumn fx:id="availableIdColumn"
                                 text="ID"
                                 prefWidth="70"/>

                    <TableColumn fx:id="availableCodeColumn"
                                 text="Class Code"
                                 prefWidth="130"/>

                    <TableColumn fx:id="availableNameColumn"
                                 text="Class Name"
                                 prefWidth="350"/>

                    <TableColumn fx:id="availableCourseColumn"
                                 text="Course"
                                 prefWidth="130"/>

                </columns>

            </TableView>


            <!-- =================================================
                 REGISTERED CLASSES
                 ================================================= -->

            <Label text="MY REGISTERED CLASSES"
                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1f2937;"/>


            <TableView fx:id="registeredClassesTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="registrationIdColumn"
                                 text="Registration ID"
                                 prefWidth="110"/>

                    <TableColumn fx:id="registeredCodeColumn"
                                 text="Class Code"
                                 prefWidth="150"/>

                    <TableColumn fx:id="registeredNameColumn"
                                 text="Class Name"
                                 prefWidth="380"/>

                    <TableColumn fx:id="registeredCourseColumn"
                                 text="Course"
                                 prefWidth="150"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>