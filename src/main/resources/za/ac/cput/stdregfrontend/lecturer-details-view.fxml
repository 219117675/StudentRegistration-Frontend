<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="za.ac.cput.stdregfrontend.LecturerDetailsController"
            fitToWidth="true"
            fitToHeight="false"
            pannable="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            prefWidth="750"
            prefHeight="650"
            style="-fx-background-color: #f4f4f4;">

    <content>

        <VBox spacing="18"
              fillWidth="true"
              style="-fx-background-color: #f4f4f4;">

            <padding>
                <Insets top="25"
                        right="30"
                        bottom="30"
                        left="30"/>
            </padding>


            <!-- ================================================= -->
            <!-- TITLE -->
            <!-- ================================================= -->

            <Label text="Lecturer Details"
                   style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1f2937;"/>


            <Label text="Complete information for the selected lecturer"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #6b7280;"/>


            <!-- ================================================= -->
            <!-- PERSONAL INFORMATION -->
            <!-- ================================================= -->

            <Label text="Personal Information"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1f2937;"/>

            <VBox spacing="10"
                  style="-fx-background-color: white;
                         -fx-background-radius: 8;
                         -fx-border-color: #e5e7eb;
                         -fx-border-radius: 8;
                         -fx-padding: 18;">

                <HBox spacing="15">
                    <Label text="Person ID:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="personIdLabel"
                           wrapText="true"/>
                </HBox>


                <HBox spacing="15">
                    <Label text="First Name:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="firstNameLabel"
                           wrapText="true"/>
                </HBox>


                <HBox spacing="15">
                    <Label text="Last Name:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="lastNameLabel"
                           wrapText="true"/>
                </HBox>


                <HBox spacing="15">
                    <Label text="Date of Birth:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="dateOfBirthLabel"
                           wrapText="true"
                           text="-"/>
                </HBox>


                <HBox spacing="15">
                    <Label text="Gender:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="genderLabel"
                           wrapText="true"
                           text="-"/>
                </HBox>


                <HBox spacing="15">
                    <Label text="Race:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="raceLabel"
                           wrapText="true"
                           text="-"/>
                </HBox>

            </VBox>


            <!-- ================================================= -->
            <!-- EMPLOYMENT INFORMATION -->
            <!-- ================================================= -->

            <Label text="Employment Information"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1f2937;"/>


            <VBox spacing="10"
                  style="-fx-background-color: white;
                         -fx-background-radius: 8;
                         -fx-border-color: #e5e7eb;
                         -fx-border-radius: 8;
                         -fx-padding: 18;">

                <HBox spacing="15">
                    <Label text="Lecturer ID:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="lecturerIdLabel"
                           wrapText="true"/>
                </HBox>


                <HBox spacing="15">
                    <Label text="Employee Number:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="employeeNumberLabel"
                           wrapText="true"/>
                </HBox>


                <HBox spacing="15">
                    <Label text="Lecturer Email:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="emailLabel"
                           wrapText="true"/>
                </HBox>


                <HBox spacing="15">
                    <Label text="Department:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="departmentLabel"
                           wrapText="true"/>
                </HBox>

            </VBox>


            <!-- ================================================= -->
            <!-- CONTACT INFORMATION -->
            <!-- ================================================= -->

            <Label text="Contact Information"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1f2937;"/>


            <VBox spacing="10"
                  style="-fx-background-color: white;
                         -fx-background-radius: 8;
                         -fx-border-color: #e5e7eb;
                         -fx-border-radius: 8;
                         -fx-padding: 18;">

                <HBox spacing="15">
                    <Label text="Contact Email:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="contactEmailLabel"
                           wrapText="true"
                           text="-"/>
                </HBox>


                <HBox spacing="15">
                    <Label text="Phone Number:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="phoneNumberLabel"
                           wrapText="true"
                           text="-"/>
                </HBox>

            </VBox>


            <!-- ================================================= -->
            <!-- ADDRESS INFORMATION -->
            <!-- ================================================= -->

            <Label text="Address"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1f2937;"/>


            <VBox spacing="10"
                  style="-fx-background-color: white;
                         -fx-background-radius: 8;
                         -fx-border-color: #e5e7eb;
                         -fx-border-radius: 8;
                         -fx-padding: 18;">

                <HBox spacing="15">
                    <Label text="Street:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="streetLabel"
                           wrapText="true"
                           text="-"/>
                </HBox>


                <HBox spacing="15">
                    <Label text="Suburb:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="suburbLabel"
                           wrapText="true"
                           text="-"/>
                </HBox>


                <HBox spacing="15">
                    <Label text="City:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="cityLabel"
                           wrapText="true"
                           text="-"/>
                </HBox>


                <HBox spacing="15">
                    <Label text="Province:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="provinceLabel"
                           wrapText="true"
                           text="-"/>
                </HBox>


                <HBox spacing="15">
                    <Label text="Postal Code:"
                           prefWidth="150"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="postalCodeLabel"
                           wrapText="true"
                           text="-"/>
                </HBox>

            </VBox>


            <!-- ================================================= -->
            <!-- ASSIGNED CLASSES -->
            <!-- ================================================= -->

            <Label text="Assigned Classes"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1f2937;"/>


            <VBox spacing="10"
                  style="-fx-background-color: white;
                         -fx-background-radius: 8;
                         -fx-border-color: #e5e7eb;
                         -fx-border-radius: 8;
                         -fx-padding: 18;">

                <Label fx:id="classesLabel"
                       wrapText="true"
                       maxWidth="650"
                       text="No classes assigned."
                       style="-fx-font-size: 14px;"/>

            </VBox>


            <!-- ================================================= -->
            <!-- CLOSE BUTTON -->
            <!-- ================================================= -->

            <HBox alignment="CENTER_RIGHT">

                <Button text="Close"
                        onAction="#onCloseClick"
                        prefWidth="110"
                        prefHeight="38"
                        style="-fx-background-color: #374151;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;"/>

            </HBox>

        </VBox>

    </content>

</ScrollPane>