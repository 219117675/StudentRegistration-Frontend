<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="za.ac.cput.stdregfrontend.AssignedClassesController"
            prefWidth="850"
            prefHeight="550">

    <!-- HEADER -->
    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="20" right="25" bottom="15" left="25"/>
            </padding>

            <Label text="Assigned Classes"
                   style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <Label text="Lecturer:"
                       style="-fx-font-weight: bold;"/>

                <Label fx:id="lecturerNameLabel"
                       style="-fx-font-size: 16px;"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Person ID:"
                       style="-fx-font-weight: bold;"/>

                <Label fx:id="lecturerIdLabel"
                       style="-fx-font-size: 16px;"/>
            </HBox>
        </VBox>
    </top>

    <!-- TABLE -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="25" bottom="10" left="25"/>
            </padding>

            <Label text="Classes assigned to this lecturer"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <TableView fx:id="assignedClassesTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="classCodeColumn"
                                 text="Class Code"
                                 prefWidth="130"/>

                    <TableColumn fx:id="classNameColumn"
                                 text="Class Name"
                                 prefWidth="230"/>

                    <TableColumn fx:id="courseCodeColumn"
                                 text="Course Code"
                                 prefWidth="120"/>

                    <TableColumn fx:id="courseNameColumn"
                                 text="Course Name"
                                 prefWidth="200"/>

                    <TableColumn fx:id="departmentColumn"
                                 text="Department"
                                 prefWidth="150"/>

                </columns>

            </TableView>
        </VBox>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox spacing="10"
              alignment="CENTER_RIGHT">

            <padding>
                <Insets top="15" right="25" bottom="20" left="25"/>
            </padding>

            <Button fx:id="refreshButton"
                    text="Refresh"
                    prefWidth="110"
                    prefHeight="38"
                    onAction="#onRefreshClick"/>

            <Button fx:id="unassignButton"
                    text="Unassign Class"
                    prefWidth="150"
                    prefHeight="38"
                    onAction="#onUnassignClick"/>

            <Button fx:id="closeButton"
                    text="Close"
                    prefWidth="110"
                    prefHeight="38"
                    onAction="#onCloseClick"/>

        </HBox>
    </bottom>

</BorderPane>